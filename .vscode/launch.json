    "version": "0.2.0",
    "configurations": [
        {
            "name": "01_find_and_tap_icon",
            "python": "my_project_venv/bin/python",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/hmi_tests",
            "args": [
                "src/01_find_and_tap_icon/find_and_tap_icon.py",
                "--config_file",
                "config_pixel3.json",
                "--res_file",
                "res_pixel3_1080_2220/res.json"
            ]
        },
        {
            "name": "02_find_and_tap_text",
            "python": "my_project_venv/bin/python",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/hmi_tests",
            "args": [
                "src/02_find_and_tap_text/find_and_tap_text.py",
                "--config_file",
                "config_pixel3.json",
            ],
            "env": {
                "TESSDATA_PREFIX": "/usr/share/tesseract-ocr/5/tessdata/"
            }
        }
    ]
